# Webserver-Einstellungen. Der Server übernimmt Änderungen hier automatisch.
# Für jede Adresse, die hier mit Namen steht, holt sich der Server das
# HTTPS-Zertifikat selbst (Let's Encrypt). Voraussetzung: Der DNS-Eintrag
# der Adresse zeigt auf diesen Server.

(seite) {
	root * /srv/current
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"
	# Besucherstatistik (Umami, ohne Cookies): Zählskript und Zähladresse
	# laufen über die eigene Adresse und werden an den Umami-Container weitergereicht
	reverse_proxy /s.js ewf-umami:3000
	reverse_proxy /api/s ewf-umami:3000
	reverse_proxy /api/send ewf-umami:3000
	file_server
}

# Auswertung der Besucherstatistik (Anmeldung nötig).
# Voraussetzung: A-Record statistik.east-westflying.de bei webgo auf 46.224.139.195
statistik.east-westflying.de {
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy ewf-umami:3000
}

# Testadresse, für Suchmaschinen gesperrt
neu.east-westflying.de {
	header X-Robots-Tag "noindex, nofollow"
	import seite
}

# Direkter Aufruf über die IP-Adresse, für Suchmaschinen gesperrt
:80 {
	header X-Robots-Tag "noindex, nofollow"
	import seite
}

# Später beim Umzug ergänzen:
# east-westflying.de, www.east-westflying.de {
# 	import seite
# }
